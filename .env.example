# 复制本文件为 .env 并填写。.env 已被 .gitignore 忽略，切勿提交。
# config.yaml 中只引用变量名，不出现任何密钥。

# 并行智算云 MaaS 平台（清华算力券）—— GLMBackend 使用
THU_MAAS_API_KEY=
# 接口根地址，OpenAI SDK 会自动拼接 /chat/completions；
# 若请求 404，尝试改为 https://llmapi.paratera.com/v1
THU_MAAS_BASE_URL=https://llmapi.paratera.com
THU_MAAS_MODEL=GLM-5.3-Flash
# DeepSeekBackend shares the MaaS key/base URL but keeps its own model name.
THU_MAAS_DEEPSEEK_MODEL=DeepSeek-V4-Flash-Vision-Exp

# 以下为后续 GPT / Claude 后端预留
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
